  "manual_findings": [
    {
      "title": "Logging out keeps the cart for the next person",
      "severity": "medium",
      "state": "sys_logout",
      "check": "review",
      "detail": "The cart lives in the browser's localStorage, not with the account. Logout only removes the session cookie, so whoever logs in next on the same browser sees the previous person's cart.",
      "fix": "Clear the cart on logout, or store it per user.",
      "evidence": [
        {
          "file": "src/components/DrawerMenu.jsx",
          "lines": "142-146",
          "note": "removeCredentials() only"
        },
        {
          "file": "src/utils/shopping-cart.js",
          "lines": "39-56",
          "note": "One global 'cart-contents' key"
        }
      ]
    },
    {
      "title": "The sort order resets every time you come back to the list",
      "severity": "low",
      "state": "inventory",
      "check": "review",
      "detail": "The list always starts sorted A to Z. Open a product and press Back, or tap Continue Shopping in the cart, and your chosen sort is gone.",
      "fix": "Keep the sort in the URL or in storage.",
      "evidence": [
        {
          "file": "src/pages/Inventory.jsx",
          "lines": "19-22",
          "note": "Initial state is A to Z on every mount"
        },
        {
          "file": "src/pages/InventoryItem.jsx",
          "lines": "59-61",
          "note": "Back pushes a fresh list page"
        }
      ]
    },
    {
      "title": "Reset App State wipes the cart with no confirmation and no undo",
      "severity": "low",
      "state": "sys_reset",
      "check": "review",
      "detail": "One tap in the menu, next to Logout, clears everything.",
      "evidence": [
        {
          "file": "src/components/DrawerMenu.jsx",
          "lines": "138-164",
          "note": "Logout and Reset sit next to each other"
        }
      ]
    },
